{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ItesDbContext": "Server=db;Port=5432;Database=itesdb;Username=ites;Password=ites;"
  },
  "JwtOptions": {
    "Issuer": "https://gurori.ru",
    "Audience": "https://ites.vercel.app",
    "Expires": "14"
  },
  "AuthorizationOptions": {
    "RolePermissions": [
      {
        "Role": "Member",
        "Permissions": [
          "AddCompetitionApplication",
          "AddOrderApplication",
          "BeMember",
          "CreateTeam",
          "AddTeamApplication",
          "HandleTeamApplication"
        ]
      },
      {
        "Role": "Client",
        "Permissions": ["CreateOrder", "HandleOrderApplication", "BeClient"]
      },
      {
        "Role": "Organizer",
        "Permissions": [
          "CreateCompetition",
          "HandleCompetitionApplication",
          "BeOrganizer",
          "Moderate"
        ]
      }
    ]
  },
  "Cors": {
    "Origins": ["https://ites.vercel.app"]
  }
}
